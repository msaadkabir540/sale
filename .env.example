# Supabase project URL.
# Local development: run `supabase start` and `npm run env:local` to generate .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key.
# RLS protects every row. Never put the service-role key in this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
